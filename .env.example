# Kopioi tämä tiedosto nimelle .env ja täytä arvot.
#
# HUOM: nämä muuttujat luetaan Vercelin ympäristöstä, eivät tästä tiedostosta.
# Aseta samat arvot Vercelin projektiasetuksiin:
# Settings → Environment Variables. Tämä tiedosto on dokumentaatio siitä,
# mitä muuttujia projekti tarvitsee.
#
# Paikallinen kehityspalvelin (dev-server.cjs) ei lue .env-tiedostoa eikä
# tarvitse mitään näistä: se jäljittelee /api/lisenssi- ja /api/ping-vastaukset
# paikallisesti. Portti on 8000, ja sen voi vaihtaa vain shell-muuttujalla:
#   PORT=3000 npm run dev

# ─── Supabase (jo käytössä api/*.js -funktioissa Vercelissä) ───
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=...

# ─── Admin-paneeli (api/admin-tilastot.js) ───
# Keksi pitkä satunnainen avain, esim: openssl rand -hex 32
ADMIN_DASHBOARD_KEY=...

# ─── Maksumuuri (middleware.js + api/lisenssi.js) ───
# Allekirjoittaa lisenssievästeen. KUN tämä on asetettu, palvelinpuolinen
# maksumuuri on PÄÄLLÄ. Kun se puuttuu, muuri on pois päältä (fail-open).
# Keksi pitkä satunnainen avain: openssl rand -hex 32
LISENSSI_JWT_SECRET=...

# ─── Upstash Redis (jaettu rate limit: api/_lib/rate.js, lisenssi.js, ping.js,
#     maailma-taulu.js, jarjestys.js, aikataulu.js) ───
# Ilman näitä rate limit toimii vain instanssikohtaisesti (muistilaskuri, joka
# nollautuu cold startissa eikä päde serverless-instanssien yli). SUOSITELTU
# tuotannossa, jotta rajat pätevät oikeasti piikissä (koko koulu kirjautuu klo 8).
# Luo ilmainen Redis-tietokanta: https://console.upstash.com → Redis → Create.
# Kopioi tietokannan "REST API" -välilehdeltä URL ja TOKEN.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Valinnainen: Vercel-deploy-tilan näyttämiseen paneelissa.
# Luo Personal Access Token: https://vercel.com/account/tokens
VERCEL_API_TOKEN=...
VERCEL_PROJECT_ID=prj_...
VERCEL_TEAM_ID=team_...
