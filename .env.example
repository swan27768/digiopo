# Kopioi tämä tiedosto nimelle .env ja täytä oma API-avaimesi
# Hanki avain: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Portti (valinnainen, oletus: 3001)
PORT=3001

# ─── Supabase (jo käytössä api/*.js -funktioissa Vercelissä) ───
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=...

# ─── Admin-paneeli (api/admin-tilastot.js) ───
# Keksi pitkä satunnainen avain, esim: openssl rand -hex 32
ADMIN_DASHBOARD_KEY=...

# ─── Maksumuuri (middleware.mjs + api/lisenssi.js) ───
# Allekirjoittaa lisenssievästeen. KUN tämä on asetettu, palvelinpuolinen
# maksumuuri on PÄÄLLÄ. Kun se puuttuu, muuri on pois päältä (fail-open).
# Keksi pitkä satunnainen avain: openssl rand -hex 32
LISENSSI_JWT_SECRET=...

# Valinnainen: Vercel-deploy-tilan näyttämiseen paneelissa.
# Luo Personal Access Token: https://vercel.com/account/tokens
VERCEL_API_TOKEN=...
VERCEL_PROJECT_ID=prj_Faadfq7ZHe3xsxJ4ZSfyoweGLnuj
VERCEL_TEAM_ID=team_o308vJFcrnS2dDWecH2xhjLh
