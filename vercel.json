{
  "redirects": [
    {
      "source": "/sivut/7luokka.html",
      "destination": "/7luokka",
      "permanent": true
    },
    {
      "source": "/sivut/8luokka.html",
      "destination": "/8luokka",
      "permanent": true
    },
    {
      "source": "/sivut/9luokka.html",
      "destination": "/9luokka",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/7luokka",
      "destination": "/sivut/7luokka.html"
    },
    {
      "source": "/8luokka",
      "destination": "/sivut/8luokka.html"
    },
    {
      "source": "/9luokka",
      "destination": "/sivut/9luokka.html"
    },
    {
      "source": "/kirjaudu",
      "destination": "/kirjaudu.html"
    },
    {
      "source": "/liity",
      "destination": "/liity.html"
    }
  ],
  "crons": [
    {
      "path": "/api/tarkista-kirjaukset",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/tarkista-virheet",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|mjs|css|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/js/osio-data-7lk.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/js/osio-data-8lk.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/js/osio-data-9lk.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/js/tehtavat.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
