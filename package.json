{
  "name": "digiopo",
  "version": "1.0.0",
  "description": "DigiOpo – peruskoulun oppilaanohjauksen digitaalinen oppimateriaali (7.–9. lk)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node dev-server.cjs",
    "css": "node tools/yhdista-css.mjs",
    "css:tarkista": "node tools/yhdista-css.mjs --tarkista",
    "kuvat:perusta": "node tools/yhdista-css.mjs && node tools/visuaalitesti.mjs perusta",
    "kuvat:vertaa": "node tools/yhdista-css.mjs && node tools/visuaalitesti.mjs vertaa",
    "luokat": "node tools/luokkatarkistus.mjs",
    "luokat:vertaa": "node tools/luokkatarkistus.mjs --vertaa"
  },
  "dependencies": {
    "@vercel/functions": "^1.6.0",
    "dotenv": "^16.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
}
